# Copy to .env.local for local overrides. Both values are read at build time.

# Hide the site from search engines (robots.txt, meta robots and an X-Robots-Tag header).
# Anything except "false" keeps the demo hidden. Set to false only when this replaces fixcar.in.
NEXT_PUBLIC_NOINDEX=true

# Base URL for the canonical link, Open Graph image and sitemap.
# Leave empty for the demo (Vercel's production URL is used, else https://www.fixcar.in).
# At launch: https://www.fixcar.in
NEXT_PUBLIC_SITE_URL=
